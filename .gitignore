# ===== 비밀키·환경설정 =====
# .env 에는 API 키가 들어 있으므로 절대 올리지 않습니다.
# .env.example 은 "이런 항목을 채우세요" 견본이라 올립니다.
.env
.env.*
!.env.example
.emv

# ===== 용량이 크거나 자동으로 다시 만들어지는 것 =====
# DART 회사코드 corpCode.xml (약 30MB)
.cache/
# 브라우저 검증 중 생기는 로그·화면구조 파일
.playwright-mcp/
*.log

# ===== 파이썬 =====
__pycache__/
*.py[cod]
.venv/
venv/
env/
.pytest_cache/

# ===== 자바스크립트 =====
node_modules/
dist/
build/

# ===== 편집기 설정 =====
.vscode/
.idea/
*.swp
*~

# ===== 운영체제가 몰래 만드는 파일 =====
# 윈도우
Thumbs.db
ehthumbs.db
desktop.ini
$RECYCLE.BIN/
# 맥
.DS_Store
._*

# ===== 개인 작업용 임시 파일 =====
tmp/
temp/
*.bak
*.orig
